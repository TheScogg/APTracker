{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "press-tracker",
  "main": "./worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/1 * * * *"
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "APTRACKER_DB",
      "database_name": "coe_db",
      "database_id": "8f86cf6d-1bfc-45ba-883e-d249014b79a1"
    }
  ],
  // Add this after creating an R2 bucket for attachments, for example:
  // "r2_buckets": [
  //   {
  //     "binding": "APTRACKER_ATTACHMENTS",
  //     "bucket_name": "ap-tracker-attachments"
  //   }
  // ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
